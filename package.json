{
  "name": "asu-gochs",
  "version": "1.0.0",
  "description": "АСУ ГО и ЧС предприятия — демонстрационная система с серверной авторизацией и базой данных SQLite",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
